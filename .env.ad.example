# ==============================================================================
# ПАРАМЕТРЫ ИНТЕГРАЦИИ С ACTIVE DIRECTORY (АО «ИНТЕРГАЗ ЦЕНТРАЛЬНАЯ АЗИЯ»)
# ==============================================================================
# Скопируйте данный файл в .env на сервере и заполните фактические параметры
# контроллеров домена вашей корпоративной сети.
# ВНИМАНИЕ: Никогда не сохраняйте личные пароли сотрудников! Для связи используется
# выделенная сервисная учётная запись с правами «ТОЛЬКО ЧТЕНИЕ» (Read-Only).

# Флаг включения прямой проверки через Active Directory
AD_ENABLED=true

# URL контроллера домена Active Directory
# Для незащищенного LDAP (порт 389, внутри корпоративного контура):
# AD_SERVER=ldap://dc01.intergas.kz:389
# Для защищенного LDAPS (порт 636, рекомендуется ИБ):
AD_SERVER=ldaps://dc01.intergas.kz:636

# Доменное имя Active Directory
AD_DOMAIN=intergas.kz

# Базовый DN для поиска пользователей и групп в домене
AD_BASE_DN=DC=intergas,DC=kz

# Контейнер (OU) сотрудников
AD_USERS_OU=OU=Users,OU=ICA,DC=intergas,DC=kz

# Сервисная учётная запись для чтения каталога (Service Account)
# Требуются права только на чтение атрибутов sAMAccountName, mail, memberOf, cn
AD_BIND_DN=CN=svc_keycloak_read,OU=ServiceAccounts,DC=intergas,DC=kz
AD_BIND_PASSWORD=ChangeThisSecureServicePassword123!

# Использовать SSL/TLS шифрование соединения
AD_USE_SSL=true

# ------------------------------------------------------------------------------
# СОПОСТАВЛЕНИЕ ДОМЕННЫХ ГРУПП БЕЗОПАСНОСТИ С РОЛЯМИ ПРИЛОЖЕНИЯ:
# ------------------------------------------------------------------------------
# Группа Главных механиков (полный доступ, паспортизация, утверждение ТО, списание):
AD_GROUP_ADMIN=GG_ICA_Mechanics

# Группа сменных инженеров и мастеров (отметка регламентов ТО, фотоосмотры, дефекты):
AD_GROUP_ENGINEER=GG_ICA_Engineers

# Группа дежурных операторов и обходчиков ГРС/КС (просмотр паспортов и графиков):
AD_GROUP_OPERATOR=GG_ICA_Operators
