{
  "realm": "mind-equip",
  "displayName": "Mind Equip — База документации и ТО",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Администратор / Главный механик — полный доступ",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "engineer",
        "description": "Сменный инженер / Механик — отметка ТО, фотоосмотры, дефекты",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "operator",
        "description": "Оператор / Наблюдатель — просмотр паспортов и графиков",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ad-ldap-intergas-federation",
        "name": "intergas-active-directory",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "ad-full-name-mapper",
              "name": "full name",
              "providerId": "full-name-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.full.name.attribute": ["cn"],
                "read.only": ["true"],
                "write.only": ["false"]
              }
            },
            {
              "id": "ad-email-mapper",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "always.read.value.from.ldap": ["true"],
                "read.only": ["true"]
              }
            },
            {
              "id": "ad-username-mapper",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["sAMAccountName"],
                "user.model.attribute": ["username"],
                "always.read.value.from.ldap": ["true"],
                "read.only": ["true"]
              }
            },
            {
              "id": "ad-group-mapper",
              "name": "group-mapper",
              "providerId": "group-ldap-mapper",
              "subComponents": {},
              "config": {
                "groups.dn": ["OU=Groups,OU=ICA,DC=intergas,DC=kz"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["group"],
                "preserve.group.inheritance": ["true"],
                "ignore.missing.groups": ["true"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["sAMAccountName"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"]
              }
            },
            {
              "id": "ad-role-mapper",
              "name": "role-mapper",
              "providerId": "role-ldap-mapper",
              "subComponents": {},
              "config": {
                "roles.dn": ["OU=Groups,OU=ICA,DC=intergas,DC=kz"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["group"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["sAMAccountName"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["ad"],
          "usernameLDAPAttribute": ["sAMAccountName"],
          "rdnLDAPAttribute": ["cn"],
          "uuidLDAPAttribute": ["objectGUID"],
          "userObjectClasses": ["person, organizationalPerson, user"],
          "connectionUrl": ["ldap://ad.intergas.kz:389"],
          "usersDn": ["OU=Users,OU=ICA,DC=intergas,DC=kz"],
          "authType": ["simple"],
          "bindDn": ["CN=svc_keycloak,OU=ServiceAccounts,DC=intergas,DC=kz"],
          "bindCredential": ["${env.AD_BIND_CREDENTIAL:ChangeMeSecret}"],
          "searchScope": ["1"],
          "useTruststoreSpi": ["always"],
          "connectionTimeout": ["5000"],
          "readTimeout": ["10000"],
          "batchSizeForSync": ["1000"],
          "allowKerberosAuthentication": ["false"],
          "useKerberosForPasswordAuthentication": ["false"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "mind-equip-app",
      "name": "Mind Equip Web Application",
      "description": "Клиент веб-приложения паспортизации и ТО оборудования",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "mind-equip-secret-2026-secure",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://*",
        "http://*",
        "https://127.0.0.1:8443/*",
        "https://localhost:8443/*",
        "https://127.0.0.1:8443/auth/callback",
        "https://localhost:8443/auth/callback",
        "https://0.0.0.0:8443/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://*##http://*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Иван",
      "lastName": "Иванов",
      "email": "admin@mind.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "engineer"
      ]
    },
    {
      "username": "engineer",
      "enabled": true,
      "firstName": "Петр",
      "lastName": "Петров",
      "email": "engineer@mind.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "engineer123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "engineer"
      ]
    },
    {
      "username": "operator",
      "enabled": true,
      "firstName": "Сергей",
      "lastName": "Сидоров",
      "email": "operator@mind.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    }
  ]
}
