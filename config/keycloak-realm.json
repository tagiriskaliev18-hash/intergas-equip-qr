{
  "realm": "mind-equip",
  "displayName": "Mind Equip — База документации и ТО",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Администратор / Главный механик — полный доступ",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "engineer",
        "description": "Сменный инженер / Механик — отметка ТО, фотоосмотры, дефекты",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "operator",
        "description": "Оператор / Наблюдатель — просмотр паспортов и графиков",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "mind-equip-app",
